<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:model="using:DropDrive.Windows.Models" x:Class="DropDrive.Windows.MainWindow" Title="DropDrive" Width="980" Height="680" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterScreen" Icon="/Assets/dropdrive.png">
  <Grid RowDefinitions="72,*,68">
    <Border Background="White" BorderBrush="#E1E7F0" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,*,Auto" Margin="26,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Image Source="/Assets/dropdrive.png" Width="34" Height="34"/><TextBlock Text="DropDrive" FontSize="20" FontWeight="Bold" Foreground="#10213D" VerticalAlignment="Center"/><Border Background="#EAF8EF" CornerRadius="12" Padding="10,4"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Fill="#28BF67" Width="7" Height="7" VerticalAlignment="Center"/><TextBlock Name="HeaderStatus" Text="Ready" FontSize="12" Foreground="#287B4B"/></StackPanel></Border></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="quiet" Content="Accounts" Click="ShowAccounts"/><Button Classes="quiet" Content="Settings" Click="ShowSettings"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="240,*">
      <Border Background="#F1F5FA" BorderBrush="#E1E7F0" BorderThickness="0,0,1,0" Padding="18,24"><StackPanel Spacing="8">
        <Button Classes="primary" HorizontalContentAlignment="Left" Content="↓   Downloads" Click="ShowDownloads"/><Button Classes="quiet" HorizontalContentAlignment="Left" Content="◷   Recent" Click="ShowHistory"/><Button Classes="quiet" HorizontalContentAlignment="Left" Content="♙   Accounts" Click="ShowAccounts"/><Button Classes="quiet" HorizontalContentAlignment="Left" Content="⚙   Settings" Click="ShowSettings"/>
        <Border Height="1" Background="#DCE3ED" Margin="0,12"/><TextBlock Text="SAVE TO" FontSize="10" FontWeight="SemiBold" Foreground="#7B899D"/>
        <Button Classes="quiet" HorizontalContentAlignment="Left" Click="ChooseFolder"><StackPanel><TextBlock Text="▱  Download folder" Foreground="#10213D"/><TextBlock Name="DestinationLabel" Text="Downloads" FontSize="11" Foreground="#7B899D" Margin="22,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180"/></StackPanel></Button>
      </StackPanel></Border>
      <Grid Grid.Column="1">
        <ScrollViewer Name="DownloadsPage"><StackPanel Margin="34,28" Spacing="18" MaxWidth="720">
          <StackPanel><TextBlock Text="Download something" FontSize="26" FontWeight="Bold" Foreground="#10213D"/><TextBlock Text="Drive, YouTube, TikTok, Instagram, Facebook or a direct link" Foreground="#6C7B91" Margin="0,5,0,0"/></StackPanel>
          <Border Classes="card" Padding="8"><Grid ColumnDefinitions="*,Auto,Auto"><TextBox Name="LinkBox" PlaceholderText="Paste one or more links" BorderThickness="0" FontSize="15" Padding="12" KeyDown="LinkBoxKeyDown"/><ToggleSwitch Grid.Column="1" Name="Mp3Toggle" Content="MP3" VerticalAlignment="Center" Margin="8,0"/><Button Grid.Column="2" Name="DownloadButton" Classes="primary" Content="Analyze" Click="AddDownload"/></Grid></Border>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold" Foreground="#10213D"/><TextBlock Grid.Column="1" Name="QueueSummary" Text="No active downloads" Foreground="#7B899D"/></Grid>
          <ItemsControl Name="DownloadList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:DownloadItem"><Border Classes="card" Padding="16" Margin="0,0,0,10"><Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
            <Border Width="44" Height="44" CornerRadius="10" Background="#EEF4FF" Grid.RowSpan="2"><TextBlock Text="↓" FontSize="22" Foreground="#1667F2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#10213D" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#7B899D" TextTrimming="CharacterEllipsis"/></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Width="48" FontFamily="Cascadia Mono,Consolas" TextAlignment="Right" VerticalAlignment="Center" Foreground="#50617A"/><Button Classes="small" Content="Cancel" Tag="{Binding}" IsVisible="{Binding CanCancel}" Click="CancelDownload"/><Button Classes="small" Content="Retry" Tag="{Binding}" IsVisible="{Binding CanRetry}" Click="RetryDownload"/></StackPanel>
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0"><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Status}" Width="82" Margin="12,0,0,0" FontSize="11" TextAlignment="Right" Foreground="#7B899D"/></Grid>
          </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Border Name="EmptyState" Classes="card" Padding="44"><StackPanel HorizontalAlignment="Center" Spacing="8"><Image Source="/Assets/dropdrive.png" Width="56" Height="56" Opacity="0.9"/><TextBlock Text="Ready when you are" FontSize="16" FontWeight="SemiBold" Foreground="#10213D" HorizontalAlignment="Center"/><TextBlock Text="Paste a link above to start downloading." Foreground="#7B899D"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <ScrollViewer Name="RecentPage" IsVisible="False"><StackPanel Margin="34,28" Spacing="18" MaxWidth="720">
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Recent" FontSize="26" FontWeight="Bold" Foreground="#10213D"/><TextBlock Text="Your last 100 completed and failed downloads" Foreground="#6C7B91" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Classes="quiet" Content="Clear history" Click="ClearHistory"/></Grid>
          <ItemsControl Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:DownloadHistoryEntry"><Border Classes="card" Padding="16" Margin="0,0,0,10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#10213D" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Source}" FontSize="11" Foreground="#7B899D"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Status}" Foreground="#50617A" HorizontalAlignment="Right"/><TextBlock Text="{Binding FinishedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="#7B899D"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Name="HistoryEmpty" Text="No download history yet." Foreground="#7B899D" HorizontalAlignment="Center" Margin="0,60"/>
        </StackPanel></ScrollViewer>
        <ScrollViewer Name="AccountsPage" IsVisible="False"><StackPanel Margin="34,28" Spacing="18" MaxWidth="720"><StackPanel><TextBlock Text="Accounts" FontSize="26" FontWeight="Bold" Foreground="#10213D"/><TextBlock Text="Use Google accounts for private Drive files" Foreground="#6C7B91" Margin="0,5,0,0"/></StackPanel><Border Classes="card" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Public Google Drive links work without signing in" FontSize="16" FontWeight="SemiBold" Foreground="#10213D"/><TextBlock Text="Private multi-account sign-in needs a Windows OAuth credential. The macOS credential cannot safely be reused for Windows." TextWrapping="Wrap" Foreground="#6C7B91"/><TextBlock Text="DropDrive will tell you when a Drive item requires access instead of failing silently." TextWrapping="Wrap" Foreground="#6C7B91"/></StackPanel></Border></StackPanel></ScrollViewer>
        <ScrollViewer Name="SettingsPage" IsVisible="False"><StackPanel Margin="34,28" Spacing="18" MaxWidth="720"><StackPanel><TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="#10213D"/><TextBlock Text="DropDrive saves these preferences on this PC" Foreground="#6C7B91" Margin="0,5,0,0"/></StackPanel><Border Classes="card" Padding="22"><StackPanel Spacing="18"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Download folder" FontWeight="SemiBold" Foreground="#10213D"/><TextBlock Name="SettingsDestinationLabel" FontSize="11" Foreground="#7B899D" MaxWidth="500" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Classes="small" Content="Change" Click="ChooseFolder"/></Grid><Border Height="1" Background="#E1E7F0"/><ToggleSwitch Name="AutoUpdateToggle" Content="Check and install updates automatically" Click="SettingsChanged"/><ToggleSwitch Name="HideToTrayToggle" Content="Keep DropDrive in the tray when the window closes" Click="SettingsChanged"/></StackPanel></Border></StackPanel></ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="White" BorderBrush="#E1E7F0" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto" Margin="26,0"><TextBlock Name="StatusLabel" Text="Ready" Foreground="#6C7B91" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Classes="quiet" Content="Check for updates" Click="CheckForUpdates" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</Window>
