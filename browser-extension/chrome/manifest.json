{
  "manifest_version": 3,
  "name": "DropDrive",
  "short_name": "DropDrive",
  "description": "Download Google Drive files directly to your Mac with DropDrive",
  "version": "5.3.0",
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DropDrive",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
