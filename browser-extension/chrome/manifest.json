{
  "manifest_version": 3,
  "name": "DropDrive",
  "short_name": "DropDrive",
  "description": "Download Google Drive files directly to your Mac with DropDrive",
  "version": "5.1.0",
  "permissions": [
    "contextMenus"
  ],
  "host_permissions": [
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DropDrive"
  }
}
