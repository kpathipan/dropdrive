<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:model="using:DropDrive.Windows.Models" x:Class="DropDrive.Windows.MainWindow" Title="DropDrive" Width="440" Height="430" MinWidth="400" MinHeight="360" MaxWidth="500" WindowStartupLocation="CenterScreen" Icon="/Assets/dropdrive.png">
  <Grid RowDefinitions="54,*,50" Background="{DynamicResource CanvasColor}">
    <Border Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,0" ColumnSpacing="9">
      <Image Source="/Assets/dropdrive.png" Width="28" Height="28" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="DropDrive" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="5,0,0,0" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#55CE81"/><TextBlock Name="HeaderStatus" Text="พร้อมใช้งาน" Width="104" FontSize="11" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Button Grid.Column="3" Classes="quiet" Width="32" Height="32" Padding="0" Content="⚙" FontSize="15" ToolTip.Tip="การตั้งค่า" Click="ShowSettings"/>
    </Grid></Border>

    <Grid Grid.Row="1">
      <ScrollViewer Name="DownloadsPage"><StackPanel Margin="18,16" Spacing="12">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="ดาวน์โหลดใหม่" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedColor}"/><TextBlock Grid.Column="1" Text="Ctrl+V" FontSize="10" Foreground="{DynamicResource MutedColor}"/></Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Name="LinkBox" Classes="compact" PlaceholderText="วางลิงก์ที่ต้องการดาวน์โหลด" FontSize="13" KeyDown="LinkBoxKeyDown" TextChanged="LinkBoxTextChanged"/><Button Grid.Column="1" Name="DownloadButton" Classes="primary" Content="วิเคราะห์" IsVisible="False" Click="AddDownload"/></Grid>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"><TextBlock Text="▰" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="บันทึกที่" FontWeight="SemiBold" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center"/><TextBlock Name="DestinationLabel" Text="ดาวน์โหลด" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="2" Classes="quiet" Content="เปลี่ยน⌄" Foreground="{DynamicResource AccentColor}" Click="ChooseFolder"/></Grid>
        <TextBlock Text="Drive, YouTube, TikTok, Facebook, Instagram · วางหลายลิงก์ได้" FontSize="10" Foreground="{DynamicResource MutedColor}"/>
        <TextBlock Name="StatusLabel" Text="" FontSize="11" Foreground="{DynamicResource MutedColor}" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="คิวดาวน์โหลด" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Name="QueueSummary" Text="ยังไม่มีรายการ" FontSize="11" Foreground="{DynamicResource MutedColor}"/></Grid>
        <ItemsControl Name="DownloadList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:DownloadItem"><Border Classes="card" Padding="12" Margin="0,0,0,8"><Grid ColumnDefinitions="38,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
          <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentSoftColor}" Grid.RowSpan="2"><TextBlock Text="↓" FontSize="18" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource MutedColor}" TextTrimming="CharacterEllipsis"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><ToggleSwitch Content="MP3" FontSize="10" IsChecked="{Binding AudioOnly, Mode=TwoWay}" IsVisible="{Binding CanStart}"/><Button Classes="small" Content="{Binding ActionLabel}" Tag="{Binding}" IsVisible="{Binding CanStart}" Click="StartDownload"/><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Width="36" FontFamily="Cascadia Mono,Consolas" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedColor}"/><Button Classes="small" Content="×" Width="28" Padding="0" Tag="{Binding}" IsVisible="{Binding CanCancel}" ToolTip.Tip="Cancel" Click="CancelDownload"/><Button Classes="small" Content="↻" Width="28" Padding="0" Tag="{Binding}" IsVisible="{Binding CanRetry}" ToolTip.Tip="Retry" Click="RetryDownload"/></StackPanel>
          <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,7,0,0"><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="3" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DisplayStatus}" Width="76" Margin="9,0,0,0" FontSize="10" TextAlignment="Right" Foreground="{DynamicResource MutedColor}"/></Grid>
        </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer>

      <ScrollViewer Name="RecentPage" IsVisible="False"><StackPanel Margin="18,16" Spacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="ล่าสุด" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="รายการดาวน์โหลด 100 รายการล่าสุด" FontSize="11" Foreground="{DynamicResource MutedColor}"/></StackPanel><Button Grid.Column="1" Classes="quiet" Content="ล้าง" Click="ClearHistory"/></Grid><ItemsControl Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:DownloadHistoryEntry"><Border Classes="card" Padding="12" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource MutedColor}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayStatus}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding FinishedAt, StringFormat={}{0:g}}" FontSize="10" Foreground="{DynamicResource MutedColor}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Name="HistoryEmpty" Text="ยังไม่มีประวัติการดาวน์โหลด" FontSize="11" Foreground="{DynamicResource MutedColor}" HorizontalAlignment="Center" Margin="0,50"/></StackPanel></ScrollViewer>

      <ScrollViewer Name="SettingsPage" IsVisible="False"><StackPanel Margin="18,16" Spacing="12"><StackPanel><TextBlock Text="การตั้งค่า" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="บันทึกไว้ในคอมพิวเตอร์เครื่องนี้" FontSize="11" Foreground="{DynamicResource MutedColor}"/></StackPanel><Border Classes="card" Padding="14"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="โฟลเดอร์ดาวน์โหลด" FontSize="12" FontWeight="SemiBold"/><TextBlock Name="SettingsDestinationLabel" FontSize="10" Foreground="{DynamicResource MutedColor}" MaxWidth="290" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Classes="small" Content="เปลี่ยน" Click="ChooseFolder"/></Grid><Border Height="1" Background="{DynamicResource BorderColor}"/><ToggleSwitch Name="AutoUpdateToggle" Content="ตรวจอัปเดตอัตโนมัติทุก 24 ชั่วโมง" FontSize="12" Click="SettingsChanged"/><ToggleSwitch Name="HideToTrayToggle" Content="ทำงานต่อในถาดระบบเมื่อปิดหน้าต่าง" FontSize="12" Click="SettingsChanged"/><Button Classes="quiet" HorizontalAlignment="Left" Padding="0,6" Content="ตรวจหาอัปเดต" Foreground="{DynamicResource AccentColor}" Click="CheckForUpdates"/></StackPanel></Border></StackPanel></ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource RailColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,*" Margin="10,5" ColumnSpacing="4"><Button Classes="quiet" Content="↓  คิวดาวน์โหลด" Click="ShowDownloads"/><Button Grid.Column="1" Classes="quiet" Content="◷  ล่าสุด" Click="ShowHistory"/></Grid></Border>
  </Grid>
</Window>
