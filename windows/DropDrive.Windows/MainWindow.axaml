<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:model="using:DropDrive.Windows.Models" x:Class="DropDrive.Windows.MainWindow" Title="DropDrive" Width="420" Height="620" MinWidth="380" MinHeight="460" MaxWidth="520" WindowStartupLocation="CenterScreen" Icon="/Assets/dropdrive.png">
  <Grid RowDefinitions="50,*,48">
    <Border Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="14,0" ColumnSpacing="8">
      <Image Source="/Assets/dropdrive.png" Width="22" Height="22" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="DropDrive" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="5,0,0,0" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="#2A9B52"/><TextBlock Name="HeaderStatus" Text="Ready" Width="96" FontSize="11" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Button Grid.Column="3" Classes="quiet" Width="30" Height="30" Padding="0" Content="◎" FontSize="16" ToolTip.Tip="Accounts" Click="ShowAccounts"/><Button Grid.Column="4" Classes="quiet" Width="30" Height="30" Padding="0" Content="⚙" FontSize="14" ToolTip.Tip="Settings" Click="ShowSettings"/>
    </Grid></Border>

    <Grid Grid.Row="1">
      <ScrollViewer Name="DownloadsPage"><StackPanel Margin="16" Spacing="12">
        <Border Classes="card" Padding="12"><StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="NEW DOWNLOAD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedColor}"/><TextBlock Grid.Column="1" Text="Ctrl+V" FontSize="10" Foreground="{DynamicResource MutedColor}"/></Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Name="LinkBox" Classes="compact" PlaceholderText="Paste a link" FontSize="13" KeyDown="LinkBoxKeyDown"/><Button Grid.Column="1" Name="DownloadButton" Classes="primary" Content="Analyze" Click="AddDownload"/></Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7"><TextBlock Text="▱" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Save to" FontSize="10" Foreground="{DynamicResource MutedColor}"/><TextBlock Name="DestinationLabel" Text="Downloads" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Classes="quiet" Content="Change" Foreground="{DynamicResource AccentColor}" Click="ChooseFolder"/></Grid>
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="YouTube, TikTok, Facebook, Instagram, Drive" FontSize="10" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" Name="Mp3Toggle" Content="MP3" FontSize="11"/></Grid>
        </StackPanel></Border>
        <TextBlock Name="StatusLabel" Text="Ready" FontSize="11" Foreground="{DynamicResource MutedColor}" TextTrimming="CharacterEllipsis"/>
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Queue" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Name="QueueSummary" Text="No active downloads" FontSize="11" Foreground="{DynamicResource MutedColor}"/></Grid>
        <ItemsControl Name="DownloadList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:DownloadItem"><Border Classes="card" Padding="12" Margin="0,0,0,8"><Grid ColumnDefinitions="36,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
          <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftColor}" Grid.RowSpan="2"><TextBlock Text="↓" FontSize="18" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource MutedColor}" TextTrimming="CharacterEllipsis"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Width="36" FontFamily="Cascadia Mono,Consolas" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedColor}"/><Button Classes="small" Content="×" Width="28" Padding="0" Tag="{Binding}" IsVisible="{Binding CanCancel}" ToolTip.Tip="Cancel" Click="CancelDownload"/><Button Classes="small" Content="↻" Width="28" Padding="0" Tag="{Binding}" IsVisible="{Binding CanRetry}" ToolTip.Tip="Retry" Click="RetryDownload"/></StackPanel>
          <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,7,0,0"><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="3" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Status}" Width="62" Margin="9,0,0,0" FontSize="10" TextAlignment="Right" Foreground="{DynamicResource MutedColor}"/></Grid>
        </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Border Name="EmptyState" Classes="card" Padding="30,26"><StackPanel HorizontalAlignment="Center" Spacing="6"><Image Source="/Assets/dropdrive.png" Width="42" Height="42" Opacity="0.9"/><TextBlock Text="Ready when you are" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Paste a link above to start." FontSize="11" Foreground="{DynamicResource MutedColor}"/></StackPanel></Border>
      </StackPanel></ScrollViewer>

      <ScrollViewer Name="RecentPage" IsVisible="False"><StackPanel Margin="16" Spacing="12"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Recent" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Your last 100 downloads" FontSize="11" Foreground="{DynamicResource MutedColor}"/></StackPanel><Button Grid.Column="1" Classes="quiet" Content="Clear" Click="ClearHistory"/></Grid><ItemsControl Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:DownloadHistoryEntry"><Border Classes="card" Padding="12" Margin="0,0,0,8"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource MutedColor}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Status}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="{Binding FinishedAt, StringFormat={}{0:g}}" FontSize="10" Foreground="{DynamicResource MutedColor}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Name="HistoryEmpty" Text="No download history yet." FontSize="11" Foreground="{DynamicResource MutedColor}" HorizontalAlignment="Center" Margin="0,60"/></StackPanel></ScrollViewer>

      <ScrollViewer Name="AccountsPage" IsVisible="False"><StackPanel Margin="16" Spacing="12"><StackPanel><TextBlock Text="Accounts" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Google Drive access" FontSize="11" Foreground="{DynamicResource MutedColor}"/></StackPanel><Border Classes="card" Padding="16"><StackPanel Spacing="9"><Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftColor}" HorizontalAlignment="Left"><TextBlock Text="G" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Public Drive links work without an account" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Private multi-account sign-in needs the Windows OAuth credential for this app." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedColor}"/></StackPanel></Border></StackPanel></ScrollViewer>

      <ScrollViewer Name="SettingsPage" IsVisible="False"><StackPanel Margin="16" Spacing="12"><StackPanel><TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Saved on this PC" FontSize="11" Foreground="{DynamicResource MutedColor}"/></StackPanel><Border Classes="card" Padding="16"><StackPanel Spacing="15"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Download folder" FontSize="12" FontWeight="SemiBold"/><TextBlock Name="SettingsDestinationLabel" FontSize="10" Foreground="{DynamicResource MutedColor}" MaxWidth="290" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Classes="small" Content="Change" Click="ChooseFolder"/></Grid><Border Height="1" Background="{DynamicResource BorderColor}"/><ToggleSwitch Name="AutoUpdateToggle" Content="Automatic updates" FontSize="12" Click="SettingsChanged"/><ToggleSwitch Name="HideToTrayToggle" Content="Keep running in tray" FontSize="12" Click="SettingsChanged"/><Button Classes="quiet" HorizontalAlignment="Left" Padding="0,6" Content="Check for updates" Foreground="{DynamicResource AccentColor}" Click="CheckForUpdates"/></StackPanel></Border></StackPanel></ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource RailColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,*" Margin="10,5" ColumnSpacing="4"><Button Classes="quiet" Content="↓  Downloads" Click="ShowDownloads"/><Button Grid.Column="1" Classes="quiet" Content="◷  Recent" Click="ShowHistory"/></Grid></Border>
  </Grid>
</Window>
