{
  "manifest_version": 3,
  "name": "DropDrive",
  "description": "Download Google Drive files directly to your Mac",
  "version": "5.0.0",
  "permissions": [
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DropDrive"
  }
}
